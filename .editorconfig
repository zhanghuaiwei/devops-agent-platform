# AI 生成:EditorConfig —— 跨编辑器统一基础格式(IDE 装 EditorConfig 插件后自动生效)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java / Python:4 空格缩进
[*.{java,py}]
indent_style = space
indent_size = 4

# Web 与配置文件:2 空格缩进
[*.{ts,tsx,js,jsx,json,yml,yaml,css,md}]
indent_style = space
indent_size = 2

# Makefile 必须用 tab(保留示例,便于后续扩展)
[Makefile]
indent_style = tab
