# AI 生成:server 镜像 Dockerfile —— 多阶段构建(构建用大镜像,运行用小镜像)
# 教程见 docs/devops-guide/01-Docker与Compose.md

# ---- 阶段 1:构建(Maven + JDK 21) ----
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
# 先拷 pom 再拷源码:利用 Docker 层缓存 —— 依赖没变时不重新下载(构建提速关键)
COPY pom.xml .
COPY devops-server/pom.xml devops-server/
COPY devops-tool-spring-boot-starter/pom.xml devops-tool-spring-boot-starter/
RUN mvn -q dependency:go-offline || true
COPY . .
RUN mvn -q package -DskipTests -pl devops-server -am

# ---- 阶段 2:运行(仅 JRE,镜像从 ~800MB 降到 ~250MB) ----
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
# 非 root 运行(安全红线:容器最小权限)
RUN addgroup -S app && adduser -S app -G app
COPY --from=build /build/devops-server/target/*.jar app.jar
RUN chown app:app app.jar
USER app
EXPOSE 8080
# JVM 参数:容器感知内存上限(F1.6 调优实验的起点)
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
