# AI 生成:环境变量样例 —— 复制为 .env 填真实值;.env 已被 .gitignore 拦截,禁止入库
# LLM(OpenAI 兼容协议,千问/DeepSeek 都走这两个变量)
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-turbo
# GitHub Tool(代码审查拉 PR diff)
GITHUB_TOKEN=
# Docker Tool(本地 socket 即可)
DOCKER_HOST=unix:///var/run/docker.sock
